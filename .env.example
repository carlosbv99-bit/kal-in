# Copiar a .env y completar. NUNCA commitear .env real.

# --- Núcleo ---
# "development" (default): /docs, /redoc y /openapi.json quedan
# disponibles — útil como catálogo real de la API (ver
# agent_core/orchestrator.py). "production": los tres se apagan (B-6,
# auditoría externa Likay-OS 2026-09-26) — evita facilitar
# reconocimiento a cualquiera con solo acceso de red.
AGENT_ENV=development
LOG_LEVEL=INFO

# --- LLM en la nube (opcional) ---
# Solo se lee si config/config.yaml tiene llm.provider: openai_compatible
# (default: "ollama", 100% local, no requiere nada de acá). Sirve para
# cualquier proveedor con API compatible con OpenAI: Qwen (DashScope),
# Grok/xAI, OpenAI, OpenRouter, etc. — ver utils/config.py::LLMConfig.
LLM_API_KEY=

# --- Credenciales multimodales ---
# IMPORTANTE: estas claves NO deben ser accesibles desde el sandbox_runner
# ni desde código generado dinámicamente por el agente. Solo el proceso
# orquestador (agent_core) las lee, y únicamente al invocar adaptadores
# ya validados y promovidos (ver kernel/registry/registry.py).
IMAGE_GEN_API_KEY=
AUDIO_GEN_API_KEY=
VIDEO_GEN_API_KEY=

# --- Memoria ---
MID_TERM_DB_URL=sqlite:///data/mid_term/memory.db
LONG_TERM_VECTOR_HOST=vector_store
LONG_TERM_VECTOR_PORT=8000

# --- Sandbox ---
SANDBOX_RUNNER_URL=http://sandbox_runner:9000
# Secreto compartido que kernel/api/sandbox_api.py exige (header
# X-Sandbox-Secret) en POST /execute — sin esto configurado, ese
# endpoint rechaza TODO pedido (fail closed). Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SANDBOX_RUNNER_SECRET=
