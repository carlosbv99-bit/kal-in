#!/usr/bin/env bash
# Instalado por scripts/install_git_hooks.py — no editar la copia en
# .git/hooks/pre-commit directamente (git no la versiona, un
# checkout/clon nuevo la pierde), editar ESTE archivo y reinstalar.
#
# Corre scripts/check_staged_skill_signatures.py: rechaza un commit
# que deja una skill con contenido modificado pero skill.sig
# desactualizado (ver el docstring de ese script para el bug real que
# motivó esto). No-op inmediato si el commit no toca skills/**.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [ -x ".venv/bin/python" ]; then
  PYTHON=".venv/bin/python"
else
  PYTHON="python3"
fi

"$PYTHON" scripts/check_staged_skill_signatures.py

# Aviso NO bloqueante (ver CONTRIBUTING.es.md, "Commits que no mezclan dos casos"): si
# hay archivos COMPARTIDOS sin commitear en cualquier repo, este commit puede mezclar
# dos casos o dejar un port a medias. No se falla a propósito: durante un port el
# árbol compartido está sucio casi siempre, y un candado que se dispara en el flujo
# normal termina desactivado. El gate explícito es `estado_de_repos.py --check`.
if ! "$PYTHON" scripts/estado_de_repos.py --check > /dev/null 2>&1; then
  echo "AVISO: hay archivos COMPARTIDOS sin commitear (este commit puede mezclar dos casos)."
  "$PYTHON" scripts/estado_de_repos.py --check | sed 's/^/  /'
fi
