__pycache__/
*.pyc
.env
# Ancladas a la raíz del repo (con "/" inicial): sin esto, "data/"/"logs/"
# también matchean cualquier subcarpeta con ese nombre en cualquier
# profundidad — mismo bug real encontrado en Likay-OS (se comía un
# archivo de verdad bajo config/includes.chroot/usr/local/), acá
# verificado que hoy no muerde a nadie (no hay data/ ni logs/ anidados
# en otro lado del repo) pero es el mismo patrón de riesgo, corregido
# antes de que llegue a causar el mismo problema.
/data/
/logs/
*.db
.pytest_cache/
.venv/
venv/
vscode-extension/node_modules/
vscode-extension/out/
vscode-extension/*.vsix

# Backups/exports locales, nunca versionados (100MB+, no pertenecen al repo)
/kal*.zip
/dist/

# Estado de runtime de Claude Code (local a esta máquina/sesión)
.claude/
